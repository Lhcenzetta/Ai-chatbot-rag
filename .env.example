# ── Copy this file to `.env` and adjust. `.env` is git-ignored. ──────────────

# Company name shown by the assistant
COMPANY_NAME=Atlas Assurances Agadir

# LLM provider: "ollama" (local, default) or "api" (OpenAI-compatible endpoint)
LLM_PROVIDER=ollama

# When LLM_PROVIDER=ollama — model must be pulled locally (`ollama pull <model>`)
OLLAMA_MODEL=gemma4:e2b

# When LLM_PROVIDER=api — works with OpenAI, Mistral API, Groq, OpenRouter, etc.
# API_BASE_URL=https://api.openai.com/v1
# API_MODEL=gpt-4o-mini
# API_KEY=sk-...            # NEVER commit the real key

# Multilingual embeddings (handles French + Arabic)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# RAG settings
DATA_DIR=data
CHROMA_DIR=chroma_db
COLLECTION_NAME=insurance_docs
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4
